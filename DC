----------------------------------------------------------------
-- ESCONDER SIDE BUTTONS
----------------------------------------------------------------

local sideButtonsConnection

local function hideSideButtons()
    local gameGui = playerGui:FindFirstChild("gameGui")
    local sideButtons = gameGui and gameGui:FindFirstChild("sideButtons", true)

    if not sideButtons or not sideButtons:IsA("GuiObject") then
        return
    end

    if sideButtonsConnection then
        sideButtonsConnection:Disconnect()
        sideButtonsConnection = nil
    end

    sideButtons.Visible = false

    sideButtonsConnection = sideButtons:GetPropertyChangedSignal("Visible"):Connect(function()
        if sideButtons.Visible then
            sideButtons.Visible = false
        end
    end)
end

playerGui.DescendantAdded:Connect(function(object)
    if object.Name == "sideButtons" then
        hideSideButtons()
    end
end)

hideSideButtons()

