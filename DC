----------------------------------------------------------------
-- ARRASTAR HUD
----------------------------------------------------------------

local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

title.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        watermark.Position = UDim2.new(frame.Position.X.Scale, frame.Position.X.Offset, 1, -5)
    end
end)

----------------------------------------------------------------
-- ATUALIZAR HUD
----------------------------------------------------------------

local startTime = tick()

task.spawn(function()
    while true do
        if strengthStat then
            strengthLabel.Text = "FORÇA: " .. formatNumber(strengthStat.Value)
        end

        local totalSeconds = math.floor(tick() - startTime)
        local hours = math.floor(totalSeconds / 3600)
        local minutes = math.floor((totalSeconds % 3600) / 60)
        local seconds = totalSeconds % 60

        sessionLabel.Text = string.format("🕐 Sessão: %02d:%02d:%02d", hours, minutes, seconds)
        task.wait(0.1)
    end
end)

