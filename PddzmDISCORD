local function loadSavedKey()

    if type(isfile) ~= "function"
        or type(readfile) ~= "function" then

        return nil
    end

    local exists =
        pcall(function()

            return isfile(
                Config.KeyFileName
            )

        end)

    if not exists then
        return nil
    end

    local success, result =
        pcall(function()

            if not isfile(
                Config.KeyFileName
            ) then

                return nil
            end

            return readfile(
                Config.KeyFileName
            )

        end)

    if success
        and type(result) == "string"
        and result ~= "" then

        return result
    end

    return nil
end

local function deleteSavedKey()

    if type(delfile) == "function" then

        pcall(function()

            if isfile
                and isfile(
                    Config.KeyFileName
                ) then

                delfile(
                    Config.KeyFileName
                )
            end

        end)
    end
end

