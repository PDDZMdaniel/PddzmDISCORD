            "CHECKING SAVED KEY..."

        Status.TextColor3 =
            Color3.fromRGB(
                255,
                140,
                220
            )

        VerifyBtn.Visible =
            false

        GetKeyBtn.Visible =
            false

        KeyInput.Visible =
            false

        if Config.ShowDiscord then

            local discord =
                MainFrame:FindFirstChild(
                    "TextButton"
                )

            if discord then
                discord.Visible =
                    false
            end
        end

        task.spawn(function()

            local success, msg =
                verifyKey(
                    savedKey
                )

            if success then

                Status.Text =
                    "AUTO LOGIN SUCCESS!"

                Status.TextColor3 =
                    Color3.fromRGB(
                        80,
                        255,
                        150
                    )

                task.wait(
                    0.6
                )

                ScreenGui:Destroy()

                StartMainScript()

            else

                ------------------------------------------------
                -- KEY EXPIRED / INVALID
                ------------------------------------------------

                deleteSavedKey()

                KeyInput.Visible =
                    true

                VerifyBtn.Visible =
                    true

                GetKeyBtn.Visible =
                    true

                if Config.ShowDiscord then

                    local discord =
                        MainFrame:FindFirstChild(
                            "TextButton"
                        )

                    if discord then
                        discord.Visible =
                            true
                    end
                end

                Status.Text =
                    "SAVED KEY EXPIRED - ENTER A NEW KEY"

                Status.TextColor3 =
                    Color3.fromRGB(
                        255,
                        150,
                        70
                    )
            end
        end)
    end

    return ScreenGui
end

