    makeLabel("Average Pace: 0 / Hour | 0 / Day | 0 / Week", 80)

timeLabel.TextColor3 = Color3.fromRGB(50, 255, 50)

local initialRebirths = rebirthsStat.Value
local startTime = tick()

local paceSamples = {}
local MAX_PACE_SAMPLES = 12

local paceStarted = false
local lastRebirthTime = nil
local lastRebirthValue = rebirthsStat.Value

local function projectedPace(gained, elapsed)
    if elapsed <= 0 or gained <= 0 then
        return 0, 0, 0
    end

    local perSecond = gained / elapsed

    return
        perSecond * 3600,
        perSecond * 86400,
        perSecond * 604800
end

local function updateAveragePace()
    local totalGained = 0
    local totalTime = 0

    for _, sample in ipairs(paceSamples) do
        totalGained += sample.gained
        totalTime += sample.elapsed
    end

    if totalTime <= 0 or totalGained <= 0 then
        return
    end

    local hour, day, week =
        projectedPace(totalGained, totalTime)

    avgPaceLabel.Text = string.format(
        "Average Pace: %s / Hour | %s / Day | %s / Week",
        formatNumber(hour),
        formatNumber(day),
        formatNumber(week)
    )
end

rebirthsStat:GetPropertyChangedSignal("Value"):Connect(function()
    local now = tick()
    local current = rebirthsStat.Value

    local totalGained =
        current - initialRebirths

    rebirthsLabel.Text = string.format(
        "Rebirths: %s | Gained: %s",
        formatNumber(current),
        formatNumber(totalGained)
    )

    if current <= lastRebirthValue then
        lastRebirthValue = current
        return
    end

    if not paceStarted then
        paceStarted = true
        lastRebirthTime = now
        lastRebirthValue = current
        lastRebirthTick = now
        return
    end

    local gainedSinceLast =
        current - lastRebirthValue

    local elapsedSinceLast =
        now - lastRebirthTime

    if gainedSinceLast > 0 and elapsedSinceLast > 0 then
        local hour, day, week =
            projectedPace(
                gainedSinceLast,
                elapsedSinceLast
            )

        paceLabel.Text = string.format(
            "Pace: %s / Hour | %s / Day | %s / Week",
            formatNumber(hour),
            formatNumber(day),
            formatNumber(week)
        )

        table.insert(
            paceSamples,
            {
                gained = gainedSinceLast,
                elapsed = elapsedSinceLast
            }
        )

        while #paceSamples > MAX_PACE_SAMPLES do
            table.remove(paceSamples, 1)
        end

        updateAveragePace()
    end

    lastRebirthTime = now
    lastRebirthValue = current
    lastRebirthTick = now
end)

task.spawn(function()
