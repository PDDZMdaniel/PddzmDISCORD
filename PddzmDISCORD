--// ============================================================
--// FPS / LOW QUALITY
--// ============================================================

local visualCache = {}
local visualCached = false
local visualConnection = nil

local function isVisualObject(obj)
    return
        obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles")
        or obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight")
        or obj:IsA("PostEffect")
        or obj:IsA("BasePart")
end

local function cacheVisualObject(obj)
    if visualCache[obj] then
        return
    end

    if not isVisualObject(obj) then
        return
    end

    if
        obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles")
    then

        visualCache[obj] = {
            Type = "Effect",
            Enabled = obj.Enabled
        }

    elseif
        obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight")
    then

        visualCache[obj] = {
            Type = "Light",
            Enabled = obj.Enabled,
            Brightness = obj.Brightness,
            Range = obj.Range
        }

    elseif obj:IsA("PostEffect") then

        visualCache[obj] = {
            Type = "PostEffect",
            Enabled = obj.Enabled
        }

    elseif obj:IsA("BasePart") then

        visualCache[obj] = {
            Type = "Part",
            Material = obj.Material,
            CastShadow = obj.CastShadow
        }
    end
end

local function cacheVisualState()
    if visualCached then
        return
    end

    visualCached = true

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do
        cacheVisualObject(obj)
    end
end

local function optimizeVisualObject(obj)
    if not State.LowQuality then
        return
    end

    if not isVisualObject(obj) then
        return
    end

    pcall(function()

        if
            obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam")
            or obj:IsA("Smoke")
            or obj:IsA("Fire")
            or obj:IsA("Sparkles")
        then

            obj.Enabled = false

        elseif
            obj:IsA("PointLight")
            or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight")
        then

            obj.Enabled = false

        elseif obj:IsA("PostEffect") then

            obj.Enabled = false

        elseif obj:IsA("BasePart") then

            obj.Material =
                Enum.Material.SmoothPlastic

            obj.CastShadow = false
        end
    end)
end

local function applyGlobalLowQuality()
    cacheVisualState()

    for obj in pairs(visualCache) do
        optimizeVisualObject(obj)
    end

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    pcall(function()
        Lighting.EnvironmentDiffuseScale = 0
    end)

    pcall(function()
        Lighting.EnvironmentSpecularScale = 0
    end)

    pcall(function()
        local terrain =
            workspace:FindFirstChildOfClass(
                "Terrain"
            )

        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
        end
    end)

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)
end

local function restoreLowQuality()
    for obj, original in pairs(
        visualCache
    ) do

        if not obj.Parent then
            continue
        end

        pcall(function()

            if original.Type == "Effect" then

                obj.Enabled =
                    original.Enabled

            elseif original.Type == "Light" then

                obj.Enabled =
                    original.Enabled

                obj.Brightness =
                    original.Brightness

                obj.Range =
                    original.Range

            elseif original.Type == "PostEffect" then

                obj.Enabled =
                    original.Enabled

            elseif original.Type == "Part" then

                obj.Material =
                    original.Material

                obj.CastShadow =
                    original.CastShadow
            end
        end)
    end

    pcall(function()
        Lighting.GlobalShadows = true
    end)

    pcall(function()
        Lighting.EnvironmentDiffuseScale = 1
    end)

    pcall(function()
        Lighting.EnvironmentSpecularScale = 1
    end)

    visualCached = false
    table.clear(visualCache)
end

local function startLowQuality()
    stopThread("LowQuality")

    applyGlobalLowQuality()

    if visualConnection then
        visualConnection:Disconnect()
    end

    visualConnection =
        workspace.DescendantAdded:Connect(
            function(obj)

                if State.LowQuality then

                    task.defer(function()
                        cacheVisualObject(obj)
                        optimizeVisualObject(obj)
                    end)

                end
            end
        )

    Threads.LowQuality =
        task.spawn(function()

            while State.LowQuality do

                task.wait(5)

                if State.LowQuality then
                    applyGlobalLowQuality()
                end
            end
        end)
end

local function stopLowQuality()
    stopThread("LowQuality")

    if visualConnection then
        visualConnection:Disconnect()
        visualConnection = nil
    end

    if visualCached then
        restoreLowQuality()
    end
end

--// ============================================================
--// ANTI-LAG
--// ============================================================

local antiLagConnection = nil

local function applyAntiLag()
    pcall(function()
        Lighting.GlobalShadows = false
    end)

    pcall(function()
        Lighting.EnvironmentDiffuseScale = 0
    end)

    pcall(function()
        Lighting.EnvironmentSpecularScale = 0
    end)

    for _, obj in ipairs(
        workspace:GetDescendants()
    ) do

        if
            obj:IsA("ParticleEmitter")
            or obj:IsA("Trail")
            or obj:IsA("Beam")
            or obj:IsA("Smoke")
            or obj:IsA("Fire")
            or obj:IsA("Sparkles")
        then

            pcall(function()
                obj.Enabled = false
            end)

        elseif
            obj:IsA("PointLight")
            or obj:IsA("SpotLight")
            or obj:IsA("SurfaceLight")
        then

            pcall(function()
                obj.Enabled = false
            end)
        end
    end
end

local function startAntiLag()
    stopThread("AntiLag")

    applyAntiLag()

    if antiLagConnection then
        antiLagConnection:Disconnect()
    end

    antiLagConnection =
        workspace.DescendantAdded:Connect(
            function(obj)

                if not State.AntiLag then
                    return
                end

                if
                    obj:IsA("ParticleEmitter")
                    or obj:IsA("Trail")
                    or obj:IsA("Beam")
                    or obj:IsA("Smoke")
                    or obj:IsA("Fire")
                    or obj:IsA("Sparkles")
                    or obj:IsA("PointLight")
                    or obj:IsA("SpotLight")
                    or obj:IsA("SurfaceLight")
                then

                    pcall(function()
                        obj.Enabled = false
                    end)
                end
            end
        )

    Threads.AntiLag =
        task.spawn(function()

            while State.AntiLag do

                task.wait(8)

                if State.AntiLag then
                    applyAntiLag()
                end
            end
        end)
end

local function stopAntiLag()
    stopThread("AntiLag")

    if antiLagConnection then
        antiLagConnection:Disconnect()
        antiLagConnection = nil
    end
end

--// ============================================================
--// LOCK MACHINE
--// ============================================================

local function startLockMachine()
    stopThread("LockMachine")

    Threads.LockMachine =
        task.spawn(function()

            local character =
                player.Character

            if not character then
                return
            end

            local root =
                character:FindFirstChild(
                    "HumanoidRootPart"
                )

            if not root then
                return
            end

            root.CFrame =
                CFrame.new(
                    TARGET_POSITION
                )

            task.wait(0.7)

            for _ = 1, 10 do

                if not State.LockMachine then
                    break
                end

                pcall(function()

                    VirtualInputManager:SendKeyEvent(
                        true,
                        Enum.KeyCode.E,
                        false,
                        game
                    )

                    task.wait(0.05)

                    VirtualInputManager:SendKeyEvent(
                        false,
                        Enum.KeyCode.E,
                        false,
                        game
                    )
                end)

                task.wait(0.05)
            end

            local deadline =
                tick() + 2

            while
                State.LockMachine
                and tick() < deadline
            do

                if getMachineSeat() then
                    break
                end

                task.wait(0.05)
            end

            local lockPosition =
                root.Position

            while State.LockMachine do

                if not root.Parent then
                    break
                end

                root.AssemblyLinearVelocity =
                    Vector3.zero

                root.AssemblyAngularVelocity =
                    Vector3.zero

                root.CFrame =
                    CFrame.new(
                        lockPosition
                    )

                task.wait(0.05)
            end
        end)
end

