-- PETS
----------------------------------------------------------------

local equipRemote =
    ReplicatedStorage.rEvents.equipPetEvent

local function equipExactPets(name, amount, delayBetween)
    local pets = findPetsByName(name)

    local equipCount =
        math.min(amount, #pets)

    if equipCount < amount then
        warn(string.format(
            "[MMB] %s: precisava de %d, encontrou %d.",
            name,
            amount,
            equipCount
        ))
    end

    for i = 1, equipCount do
        pcall(function()
            equipRemote:FireServer(
                "equipPet",
                pets[i]
            )
        end)

        if delayBetween and delayBetween > 0 then
            task.wait(delayBetween)
        end
    end

    return equipCount
end

----------------------------------------------------------------
-- LOADOUT REP
----------------------------------------------------------------

local function equipRepLoadout()
    local tribals =
        findPetsByName("Tribal Overlord")

    -- Remove os Tribal Overlord.
    for i = 1, math.min(3, #tribals) do
        pcall(function()
            equipRemote:FireServer(
                "unequipPet",
                tribals[i]
            )
        end)
    end

    -- Sem espera entre unequip/equip.
    if PET_SWITCH_DELAY > 0 then
        task.wait(PET_SWITCH_DELAY)
    end

    -- Equipa Swift Samurai.
    equipExactPets(
        "Swift Samurai",
        3,
        PET_DELAY
    )

    -- Equipa Rare Boss Pet.
    equipExactPets(
        "Rare Boss Pet",
        5,
        PET_DELAY
    )

    if PET_SWITCH_DELAY > 0 then
        task.wait(PET_SWITCH_DELAY)
    end
end

----------------------------------------------------------------
-- LOADOUT REBIRTH
----------------------------------------------------------------

local function equipRebirthLoadout()
    local swifts =
        findPetsByName("Swift Samurai")

    local bosses =
        findPetsByName("Rare Boss Pet")

    -- Remove Swift Samurai.
    for i = 1, math.min(3, #swifts) do
        pcall(function()
            equipRemote:FireServer(
                "unequipPet",
                swifts[i]
            )
        end)
    end

    -- Remove Rare Boss Pet.
    for i = 1, math.min(5, #bosses) do
        pcall(function()
            equipRemote:FireServer(
                "unequipPet",
                bosses[i]
            )
        end)
    end

    if PET_SWITCH_DELAY > 0 then
        task.wait(PET_SWITCH_DELAY)
    end

    -- Equipa Tribal Overlord.
    equipExactPets(
        "Tribal Overlord",
        3,
        PET_DELAY
    )

    if PET_SWITCH_DELAY > 0 then
        task.wait(PET_SWITCH_DELAY)
    end
end

----------------------------------------------------------------
-- FARM DE FORÇA
----------------------------------------------------------------

local function farmStrength(target)
    while isRunning and strengthStat.Value < target do

        for i = 1, REP_BATCH do
            if not isRunning or strengthStat.Value >= target then
                break
            end

            pcall(function()
                muscleEvent:FireServer("rep")
            end)
        end

        if REP_DELAY > 0 then
            task.wait(REP_DELAY)
        else
            task.wait()
        end
    end
end

----------------------------------------------------------------
-- REBIRTH ULTRA RÁPIDO
----------------------------------------------------------------

local function doRebirth()
    local rebirths =
        rebirthsStat.Value

    local strengthTarget =
        5000 + (rebirths * 2550)

    ------------------------------------------------------------
    -- FARM
    ------------------------------------------------------------

    farmStrength(strengthTarget)

    if not isRunning then
        return
    end

    if strengthStat.Value < strengthTarget then
        return
    end

    ------------------------------------------------------------
    -- TROCA PARA TRIBAL
    ------------------------------------------------------------

    equipRebirthLoadout()

    ------------------------------------------------------------
    -- REBIRTH
    ------------------------------------------------------------

    local before =
        rebirthsStat.Value

    local attempts = 0

    repeat
        attempts += 1

        pcall(function()
            ReplicatedStorage.rEvents.rebirthRemote:
                InvokeServer("rebirthRequest")
        end)

        -- Somente cede o frame se não houver delay configurado.
        if REBIRTH_DELAY > 0 then
            task.wait(REBIRTH_DELAY)
        else
            task.wait()
        end

        -- Proteção contra servidor sem resposta.
        if attempts >= 100 then
            warn("[MMB] Rebirth não confirmou após 100 tentativas.")
            break
        end

    until rebirthsStat.Value > before
        or not isRunning

    if rebirthsStat.Value > before then
        lastRebirthTick = tick()
    end
end

----------------------------------------------------------------
-- LOOP PRINCIPAL
----------------------------------------------------------------

local function startRebirthLoop()
    if rebirthThread then
        task.cancel(rebirthThread)
        rebirthThread = nil
    end

    isRunning = true

    rebirthThread = task.spawn(function()
        while isRunning do

            ----------------------------------------------------
            -- LOADOUT DE FARM
            ----------------------------------------------------

            equipRepLoadout()

            ----------------------------------------------------
            -- FARM + REBIRTH
            ----------------------------------------------------

            doRebirth()

            -- Não adiciona delay artificial.
            task.wait()
        end
    end)
end

