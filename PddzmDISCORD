task.spawn(function()

    while screenGui.Parent do

        if strengthStat then

            hudStrength.Text =
                "💪  Força: "
                ..
                formatNumber(
                    strengthStat.Value
                )
        end

        if rebirthsStat then

            hudRebirth.Text =
                "🔄  Rebirths: "
                ..
                formatNumber(
                    rebirthsStat.Value
                )
        end

        hudPace.Text =
            string.format(
                "⚡  Ritmo: %.1f RB/min",
                currentRBPerMinute
            )

        if State.FastFarm then

            hudFarm.Text =
                "⚡  Farm: FAST x500 ATIVO"

            hudFarm.TextColor3 =
                GREEN

        elseif State.AutoFarm then

            hudFarm.Text =
                "💪  Farm: ATIVO"

            hudFarm.TextColor3 =
                GREEN

        else

            hudFarm.Text =
                "💪  Farm: DESATIVADO"

            hudFarm.TextColor3 =
                WHITE
        end

        setStatusText(
            hudRebirthState,
            "🔄  Rebirth: ",
            State.AutoRebirth
        )

        if State.AntiAFK then

            local elapsed =
                math.max(
                    0,
                    math.floor(
                        tick()
                        -
                        antiAFKStartTime
                    )
                )

            hudAntiAFK.Text =
                string.format(
                    "🛡️  Anti-AFK: ATIVO  •  %s",
                    formatDuration(
                        elapsed
                    )
                )

            hudAntiAFK.TextColor3 =
                GREEN

        else

            hudAntiAFK.Text =
                "🛡️  Anti-AFK: DESATIVADO"

            hudAntiAFK.TextColor3 =
                WHITE
        end

        local ping =
            getPing()

        if ping then

            hudPing.Text =
                "📶  Ping: "
                ..
                tostring(ping)
                ..
                " ms"

            if ping <= 80 then

                hudPing.TextColor3 =
                    GREEN

            elseif ping <= 150 then

                hudPing.TextColor3 =
                    Color3.fromRGB(
                        255,
                        200,
                        80
                    )

            else

                hudPing.TextColor3 =
                    RED
            end

        else

            hudPing.Text =
                "📶  Ping: -- ms"

            hudPing.TextColor3 =
                WHITE
        end

        hudTime.Text =
            "🕐  Time: "
            ..
            os.date("%H:%M:%S")

        hudTime.TextColor3 =
            WHITE

        hudTempo.Text =
            "⏱️  Tempo: "
            ..
            formatDuration(
                tick()
                -
                sessionStart
            )

        hudTempo.TextColor3 =
            WHITE

        task.wait(0.5)
    end
end)

