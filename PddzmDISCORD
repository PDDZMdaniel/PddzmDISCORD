local CachedLink = ""
local CachedTime = 0

local UseNonce = true

----------------------------------------------------------------
-- CONNECTIVITY
----------------------------------------------------------------

local function checkConnectivity()

    local response =
        safeRequest({

            Url =
                Host ..
                "/public/connectivity",

            Method =
                "GET"
        })

    if response
        and (
            response.StatusCode == 200
            or response.StatusCode == 429
        ) then

        return true
    end

    Host =
        "https://api.platoboost.net"

    local fallback =
        safeRequest({

            Url =
                Host ..
                "/public/connectivity",

            Method =
                "GET"
        })

    if fallback
        and (
            fallback.StatusCode == 200
            or fallback.StatusCode == 429
        ) then

        return true
    end

    return false
end

----------------------------------------------------------------
-- NONCE
----------------------------------------------------------------

local function generateNonce()

    local chars =
        "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

    local result = ""

    for i = 1, 16 do

        local index =
            math.random(
                1,
                #chars
            )

        result =
            result ..
            chars:sub(
                index,
                index
            )
    end

    return result
end

----------------------------------------------------------------
-- GET KEY LINK
----------------------------------------------------------------

local function getKeyLink()

    if not checkConnectivity() then

        return false,
            "Network error. Check your connection or executor."
    end

    if CachedLink ~= ""
        and CachedTime + 600 > os.time() then

        return true,
            CachedLink
    end

    local identifier =
        getIdentifier()

    local body =
        HttpService:JSONEncode({

            service =
                Config.ServiceId,

            identifier =
                identifier
        })

    local response, err =
        safeRequest({

            Url =
                Host ..
                "/public/start",

            Method =
                "POST",

            Body =
                body,

            Headers = {

                ["Content-Type"] =
                    "application/json"
            }
        })

    if not response then

        return false,
            err or "Server unreachable."
    end

    if response.StatusCode ~= 200 then

        return false,
            "Server returned HTTP " ..
            tostring(
                response.StatusCode
            )
    end

    local success, decoded =
        pcall(function()

            return HttpService:JSONDecode(
                response.Body
            )

        end)

    if not success
        or type(decoded) ~= "table" then

        return false,
            "Invalid server response."
    end

    if decoded.success
        and decoded.data
        and decoded.data.url then

        CachedLink =
            decoded.data.url

        CachedTime =
            os.time()

        return true,
            CachedLink
    end

    return false,
        decoded.message
        or
        "Unable to generate key link."
end

----------------------------------------------------------------
-- VERIFY / REDEEM KEY
----------------------------------------------------------------

local function verifyKey(key)

    if type(key) ~= "string"
        or key == "" then

        return false,
            "KEY IS ERRO"
    end

    if not checkConnectivity() then

        return false,
            "Network error."
    end

    local nonce =
        generateNonce()

    local body = {

        identifier =
            getIdentifier(),

        key =
            key
    }

    if UseNonce then

        body.nonce =
            nonce
    end

    local response, err =
        safeRequest({

            Url =
                Host ..
                "/public/redeem/" ..
                tostring(
                    Config.ServiceId
                ),

            Method =
                "POST",

            Body =
                HttpService:JSONEncode(
                    body
                ),

            Headers = {

                ["Content-Type"] =
                    "application/json"
            }
        })

    if not response then

        return false,
            err
            or
            "SERVER ERROR"
    end

    if response.StatusCode ~= 200 then

        return false,
            "SERVER ERROR"
    end

    local success, decoded =
        pcall(function()

            return HttpService:JSONDecode(
                response.Body
            )

        end)

    if not success
        or type(decoded) ~= "table" then

        return false,
            "Invalid server response."
    end

    ------------------------------------------------------------
    -- KEY INVALID
    ------------------------------------------------------------

    if not decoded.success
        or not decoded.data
        or not decoded.data.valid then

        return false,
            decoded.message
            or
            "KEY IS ERRO"
    end

    ------------------------------------------------------------
    -- NONCE VALIDATION
    ------------------------------------------------------------

    if UseNonce then

        local serverHash =
            decoded.data.hash

        local expectedHash =
            sha256(
                "true"
                ..
                "-"
                ..
                nonce
                ..
                "-"
                ..
                Config.PlatoSecret
            )

        if serverHash ~= expectedHash then

            return false,
                "KEY IS ERRO"
        end
    end

    ------------------------------------------------------------
    -- SAVE VALID KEY
    ------------------------------------------------------------

    saveKey(key)

    return true,
        "KEY IS CORRECT"
end

