        local success, result =
            pcall(gethwid)

        if success
            and result then

            return sha256(
                tostring(result)
            )
        end
    end

    local success, clientId =
        pcall(function()

            return game:GetService(
                "RbxAnalyticsService"
            ):GetClientId()

        end)

    if success
        and clientId then

        return sha256(
            tostring(clientId)
        )
    end

    error(
        "Unable to obtain executor identifier."
    )
end

