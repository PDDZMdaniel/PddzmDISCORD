local Threads = {}
local farmToken = 0

local function stopThread(name)
    local thread = Threads[name]

    if thread then
        pcall(function()
            task.cancel(thread)
        end)

        Threads[name] = nil
    end
end

local function stopAllThreads()
    for name in pairs(Threads) do
        stopThread(name)
    end
end

--// ============================================================
--// PET CACHE
--// ============================================================

local petCache = {}

local function rebuildPetCache()
    table.clear(petCache)

    if not petsFolder then
        return
    end

    for _, folder in ipairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do
                petCache[pet.Name] =
                    petCache[pet.Name] or {}

                table.insert(
                    petCache[pet.Name],
                    pet
                )
            end
        end
    end
end

rebuildPetCache()

if petsFolder then
    petsFolder.DescendantAdded:Connect(function()
        task.defer(rebuildPetCache)
    end)

    petsFolder.DescendantRemoving:Connect(function()
        task.defer(rebuildPetCache)
    end)
end

local function getPets(name)
    return petCache[name] or {}
end

--// ============================================================
--// PET REMOTE
--// ============================================================

local function getEquipRemote()
    local rEvents =
        ReplicatedStorage:FindFirstChild("rEvents")

    if not rEvents then
        return nil
    end

    return rEvents:FindFirstChild("equipPetEvent")
end

local function equipPets(name, amount)
    local remote = getEquipRemote()

    if not remote then
        return 0
    end

    local pets = getPets(name)
    local count = math.min(amount, #pets)

    for i = 1, count do
        pcall(function()
            remote:FireServer(
                "equipPet",
                pets[i]
            )
        end)

        if PET_DELAY > 0 then
            task.wait(PET_DELAY)
        end
    end

    return count
end

local function unequipPets(name, amount)
    local remote = getEquipRemote()

    if not remote then
        return
    end

    local pets = getPets(name)
    local count = math.min(amount, #pets)

    for i = 1, count do
        pcall(function()
            remote:FireServer(
                "unequipPet",
                pets[i]
            )
        end)

        if PET_DELAY > 0 then
            task.wait(PET_DELAY)
        end
    end
end

