--// ============================================================
--// FAST FARM 2.0
--// Só funciona através do AUTO REBIRTH
--// Fluxo:
--// FARM -> REQUISITO -> PARA -> REBIRTH -> FARM NOVAMENTE
--// ============================================================

local function stopFastFarm()
    State.FastFarm = false

    farmToken = farmToken + 1

    stopThread("FastFarm")
end

local function startFastFarm()
    stopFastFarm()

    State.FastFarm = true

    farmToken = farmToken + 1

    local myToken = farmToken

    Threads.FastFarm = task.spawn(function()

        while State.FastFarm
            and State.AutoRebirth
            and farmToken == myToken do

            if not muscleEvent then
                task.wait(0.1)
                continue
            end

            -- Faz um ciclo de 500 reps
            for i = 1, REPS_PER_CYCLE do

                if not State.FastFarm
                    or not State.AutoRebirth
                    or farmToken ~= myToken then
                    break
                end

                pcall(function()
                    muscleEvent:FireServer("rep")
                end)

                -- Pequena pausa para não bloquear o cliente
                if i % 25 == 0 then
                    task.wait()
                end
            end

            if State.FastFarm
                and State.AutoRebirth
                and farmToken == myToken then

                task.wait(FARM_DELAY)
            end
        end

    end)
end

--// ============================================================
--// AUTO REBIRTH + FAST FARM 2.0
--// ============================================================

local function getStrengthRequired()
    if not rebirthsStat then
        return math.huge
    end

    local currentRebirths = rebirthsStat.Value

    return 5000 + (currentRebirths * 2550)
end

local function waitForStrengthRequirement()

    if not strengthStat then
        return false
    end

    local required = getStrengthRequired()

    -- Enquanto não tiver força suficiente,
    -- o Fast Farm 2.0 permanece ativo.
    while State.AutoRebirth
        and strengthStat.Value < required do

        if not State.FastFarm then
            startFastFarm()
        end

        task.wait(0.05)

        required = getStrengthRequired()
    end

    return State.AutoRebirth
        and strengthStat.Value >= required
end

local function performRebirth()

    local rEvents =
        ReplicatedStorage:FindFirstChild("rEvents")

    local remote =
        rEvents
        and rEvents:FindFirstChild("rebirthRemote")

    if not remote then
        return false
    end

    local success = pcall(function()
        remote:InvokeServer("rebirthRequest")
    end)

    return success
end

local function startAutoRebirth()

    stopThread("AutoRebirth")

    Threads.AutoRebirth = task.spawn(function()

        while State.AutoRebirth do

            -- ==================================================
            -- 1. CALCULA O REQUISITO ATUAL
            -- ==================================================

            local required =
                getStrengthRequired()

            -- ==================================================
            -- 2. FAST FARM 2.0
            -- ==================================================

            if strengthStat
                and strengthStat.Value < required then

                if not State.FastFarm then
                    startFastFarm()
                end

                -- Espera atingir o requisito
                while State.AutoRebirth
                    and strengthStat.Value < required do

                    task.wait(0.05)

                    required =
                        getStrengthRequired()
                end
            end

            if not State.AutoRebirth then
                break
            end

            -- ==================================================
            -- 3. ATINGIU O REQUISITO
            -- ==================================================

            if strengthStat
                and strengthStat.Value >= required then

                -- PARA O FAST FARM ANTES DO REBIRTH
                stopFastFarm()

                -- ==================================================
                -- 4. EQUIPA PETS DE REBIRTH
                -- ==================================================

                if State.AutoPets then
                    equipRebirthPets()
                end

                task.wait(PET_DELAY)

                -- ==================================================
                -- 5. FAZ O REBIRTH
                -- ==================================================

                local before =
                    rebirthsStat
                    and rebirthsStat.Value
                    or 0

                local attempts = 0

                repeat

                    if not State.AutoRebirth then
                        break
                    end

                    performRebirth()

                    attempts =
                        attempts + 1

                    task.wait(REBIRTH_DELAY)

                    -- Segurança contra remote que não responde
                    if attempts >= 20 then
                        break
                    end

                until
                    (
                        rebirthsStat
                        and rebirthsStat.Value > before
                    )
                    or not State.AutoRebirth

                -- ==================================================
                -- 6. EQUIPA PETS DE FARM NOVAMENTE
                -- ==================================================

                if State.AutoRebirth
                    and State.AutoPets then

                    equipFarmPets()
                end

                task.wait(PET_DELAY)

                -- ==================================================
                -- 7. FAST FARM 2.0 VOLTA AUTOMATICAMENTE
                -- ==================================================

                if State.AutoRebirth then
                    startFastFarm()
                end
            end

            task.wait(0.05)
        end

        -- Se Auto Rebirth desligar,
        -- Fast Farm 2.0 também desliga.
        stopFastFarm()
    end)
end

