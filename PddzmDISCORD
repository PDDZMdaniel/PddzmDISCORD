        pcall(function()

            playerGui[
                Config.OldGuiName
            ]:Destroy()

        end)
    end

    ------------------------------------------------------------
    -- Load script
    ------------------------------------------------------------

    local success, result =
        pcall(function()

            return loadstring(
                game:HttpGet(
                    Config.MainScriptURL
                )
            )()

        end)

    if not success then

        warn(
            "[DANIELDZM] Main script error:",
            result
        )

        return false
    end

    return true
end

