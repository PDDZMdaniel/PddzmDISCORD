local function getMachineSeat()
    if not machineInUse then
        machineInUse =
            player:FindFirstChild("machineInUse")
    end

    if not machineInUse then
        return nil
    end

    local success, value =
        pcall(function()
            return machineInUse.Value
        end)

    if not success or not value then
        return nil
    end

    if value:IsA("Seat")
        or value:IsA("VehicleSeat")
        or value:IsA("BasePart") then
        return value
    end

    return nil
end

