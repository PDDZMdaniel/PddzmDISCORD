----------------------------------------------------------------
-- REQUEST
----------------------------------------------------------------

local function getRequestFunction()

    return request
        or http_request
        or syn_request
        or (syn and syn.request)
        or (http and http.request)
end

local function safeRequest(options)

    local req =
        getRequestFunction()

    if not req then

        return nil,
            "HTTP requests are not supported by this executor."
    end

    local success, response =
        pcall(function()

            return req(options)

        end)

    if not success then

        return nil,
            tostring(response)
    end

    if type(response) ~= "table" then

        return nil,
            "Invalid HTTP response."
    end

    return response
end

----------------------------------------------------------------
-- SHA256
----------------------------------------------------------------

local function sha256(value)

    if type(crypt) == "table"
        and type(crypt.hash) == "function" then

        local success, result =
            pcall(function()

                return crypt.hash(
                    value,
                    "sha256"
                )

            end)

        if success
            and type(result) == "string" then

            return result
        end
    end

    error(
        "SHA256 is unavailable. Your executor needs crypt.hash."
    )
end

