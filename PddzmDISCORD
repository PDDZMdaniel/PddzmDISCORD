        sideButtonsConnection:Disconnect()
        sideButtonsConnection = nil
    end

    sideButtons.Visible = false

    sideButtonsConnection =
        sideButtons:GetPropertyChangedSignal("Visible"):Connect(function()
            if sideButtons.Visible then
                sideButtons.Visible = false
            end
        end)
