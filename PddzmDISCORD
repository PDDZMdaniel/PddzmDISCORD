--// STOP ALL
--// ============================================================

local function stopAll()

    stopAllThreads()
    stopAntiLag()
    stopAntiAFK()

    if visualConnection then
        visualConnection:Disconnect()
        visualConnection = nil
    end

    for key in pairs(State) do
        State[key] = false
    end

    farmToken =
        farmToken + 1

    blackScreenGui.Enabled =
        false

    if visualCached then
        restoreLowQuality()
    end
end

