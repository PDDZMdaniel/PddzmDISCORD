local function startPositionLock()
    lockEnabled = true

    task.spawn(function()
        local c =
            player.Character
            or player.CharacterAdded:Wait()

        local h =
            c:WaitForChild("HumanoidRootPart")

        local lockPos =
            h.Position

        while lockEnabled do
            if h.Parent then
                h.Velocity =
                    Vector3.new(0, 0, 0)

                h.RotVelocity =
                    Vector3.new(0, 0, 0)

                h.CFrame =
                    CFrame.new(lockPos)
            end

            task.wait(0.1)
        end
    end)
end

----------------------------------------------------------------
-- INITIALIZE
----------------------------------------------------------------

local function initialize()
    if initializing then
        return
    end

    initializing = true
    isRunning = false
    lockEnabled = false

    if rebirthThread then
        task.cancel(rebirthThread)
        rebirthThread = nil
    end

    local char =
        player.Character
        or player.CharacterAdded:Wait()

    local humanoid =
        char:WaitForChild("Humanoid")

    if humanoid.Health <= 0 then
        char = player.CharacterAdded:Wait()
        task.wait(1)
    end

    task.wait(0.5)

    ------------------------------------------------------------
    -- SIZE
    ------------------------------------------------------------

    ensureSizeOne()

    ------------------------------------------------------------
    -- ANTI-LAG
    ------------------------------------------------------------

    applyAntiLag()

    ------------------------------------------------------------
    -- FORÇA INICIAL
    ------------------------------------------------------------

    if strengthStat.Value < 1000000 then
        local weightTool =
            player.Character:FindFirstChild("Weight")
            or player.Backpack:FindFirstChild("Weight")

        if weightTool then
            local currentCharacter =
                player.Character

            local currentHumanoid =
                currentCharacter:FindFirstChildOfClass("Humanoid")

            if currentHumanoid then
                currentHumanoid:EquipTool(weightTool)

                task.wait(0.2)

                while strengthStat.Value < 1000000 do

                    pcall(function()
                        muscleEvent:FireServer("rep")
                    end)

                    if REP_DELAY > 0 then
                        task.wait(REP_DELAY)
                    else
                        task.wait()
                    end
                end

                currentHumanoid:UnequipTools()

                task.wait(0.2)
            end
        end

        ensureSizeOne()
    end

    ------------------------------------------------------------
    -- INDUSTRIAL SQUAT
    ------------------------------------------------------------

    char =
        player.Character
        or player.CharacterAdded:Wait()

    local hrp =
        char:WaitForChild("HumanoidRootPart")

    hrp.CFrame = CFrame.new(
        -5218.76,
        56.42,
        5418.26
    )

    task.wait(0.7)

    ------------------------------------------------------------
    -- E
    ------------------------------------------------------------

    for i = 1, 10 do
        VirtualInputManager:SendKeyEvent(
            true,
            Enum.KeyCode.E,
            false,
            game
        )

        task.wait(0.05)

        VirtualInputManager:SendKeyEvent(
            false,
            Enum.KeyCode.E,
            false,
            game
        )

        task.wait(0.05)
    end

    task.wait(1)

    ------------------------------------------------------------
    -- LOCK
    ------------------------------------------------------------

    startPositionLock()

    ------------------------------------------------------------
    -- START
    ------------------------------------------------------------

    lastRebirthTick = tick()
    initializing = false

    startRebirthLoop()
end

