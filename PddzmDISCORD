local petCache = {}

local function rebuildPetCache()
    table.clear(petCache)

    for _, folder in ipairs(player.petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in ipairs(folder:GetChildren()) do
                local name = pet.Name

                if not petCache[name] then
                    petCache[name] = {}
                end

                table.insert(petCache[name], pet)
            end
        end
    end
end

rebuildPetCache()

player.petsFolder.DescendantAdded:Connect(function()
    task.defer(rebuildPetCache)
end)

player.petsFolder.DescendantRemoving:Connect(function()
    task.defer(rebuildPetCache)
end)

local function findPetsByName(name)
    return petCache[name] or {}
end

